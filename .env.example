# Set automatically by .github/workflows/deploy.yml on GitHub Pages.
# "" for a <user>.github.io repository, "/<repo>" for a project repository.
NEXT_PUBLIC_BASE_PATH=
# Canonical site URL (SEO, sitemap, Open Graph), e.g. https://zouhourabdelli123.github.io
NEXT_PUBLIC_SITE_URL=
# Web3Forms access key (public-safe). Alternatively paste it in src/lib/site.ts.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
